# GenSupportAI Backend Environment Settings
PROJECT_NAME="GenSupportAI"

# Relational Database URL
# SQLite configuration (default):
# DATABASE_URL="sqlite:///./gensupport.db"
# PostgreSQL configuration:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gensupport_db"

# Storage Settings
UPLOAD_DIR="./uploads"
CHROMA_DB_DIR="./chroma_db"

# RAG Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# LLM Inference Server (Ollama)
OLLAMA_URL="http://localhost:11434"
LLM_MODEL="gemma2:9b"
